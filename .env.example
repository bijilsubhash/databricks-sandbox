# Copy to .env (gitignored) and fill in your real values.
# Loaded automatically by `just` (dotenv) and by direnv (.envrc) for your shell.
# Nothing here is a hard secret -- real auth tokens live in ~/.aws and
# ~/.databrickscfg -- but account IDs and emails are kept out of git via .env.

# --- Local profile / CLI wiring (consumed by the justfile and the CLIs) ---
AWS_PROFILE=your-aws-sso-profile
DATABRICKS_CONFIG_PROFILE=your-databricks-account-profile
DATABRICKS_ACCOUNT_HOST=https://accounts.cloud.databricks.com
DATABRICKS_ACCOUNT_ID=00000000-0000-0000-0000-000000000000

# --- Terraform input variables (TF_VAR_* -> var.* in infra/) ---
# These override infra/variables.tf defaults and feed the identity resources.
TF_VAR_databricks_account_id=00000000-0000-0000-0000-000000000000
TF_VAR_databricks_account_profile=your-databricks-account-profile
TF_VAR_aws_profile=your-aws-sso-profile
TF_VAR_prefix=my-sandbox
TF_VAR_my_email=you@example.com
TF_VAR_sandbox_user_email=service-user@example.com
